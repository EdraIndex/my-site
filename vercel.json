{
  "functions": {
    "api/generate-proposal.js": {
      "maxDuration": 60
    },
    "api/approve-proposal.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/meet-edra",
      "destination": "/meet-edra.html"
    },
    {
      "source": "/option-india",
      "destination": "/option-india.html"
    },
    {
      "source": "/option-global",
      "destination": "/option-global.html"
    },
    {
      "source": "/sign-in",
      "destination": "/sign-in.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/about",
      "destination": "/about.html"
    },
    {
      "source": "/frameworks",
      "destination": "/frameworks.html"
    },
    {
      "source": "/platform",
      "destination": "/platform.html"
    },
    {
      "source": "/approach",
      "destination": "/approach.html"
    },
    {
      "source": "/brsr-core",
      "destination": "/brsr-core.html"
    },
    {
      "source": "/sample-report",
      "destination": "/sample-report.html"
    },
    {
      "source": "/imn",
      "destination": "/imn-danapoint.html"
    },
    {
      "source": "/imn-sales",
      "destination": "/imn-sales.html"
    },
    {
      "source": "/imn-newport",
      "destination": "/imn-newport.html"
    },
    {
      "source": "/time-compression",
      "destination": "/time-compression.html"
    }
  ],
  "redirects": [
    {
      "source": "/usa",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/usa.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/uk",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/uk.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/apac",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/apac.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/aus",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/aus.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.edraindex.com"
        }
      ],
      "destination": "https://edraindex.com/$1",
      "permanent": true
    }
  ]
}
